{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-root-ssh.sh",
            "args": [],
            "timeout": 15,
            "statusMessage": "Checking SSH target is not root..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-secret-write.sh",
            "args": [],
            "timeout": 15,
            "statusMessage": "Scanning write for live secrets..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-repo.sh",
            "args": [],
            "timeout": 90,
            "statusMessage": "Validating machine records..."
          }
        ]
      }
    ]
  }
}
